diff --git a/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c b/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c
index d0c7922..8666216 100644
--- a/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c
+++ b/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c
@@ -290,7 +290,14 @@ mwv207_drm_bo_map(struct mwv207_winsys *ws, struct mwv207_bo *bo)
 
    bo->logical = (char *)ptr + bo->offset;
 
-   return ptr;
+   /* FIX(jm9100-oss): O2 —— 返回值语义必须与上面的缓存分支一致。
+    * 全函数以 bo->logical（= ptr + bo->offset）作为"该 BO 的 CPU 地址"的
+    * 唯一语义, 而这里却返回未加偏移的 ptr。一旦 slab 子分配被启用
+    * (bo->offset != 0), 同一 BO 首次映射与后续命中缓存会返回两个不同地址,
+    * 调用方按 bo->offset 之外的口径写入就会写到相邻 BO 上。
+    * 当前 MWV207_FLAG_SUBALLOC 从未写入 pipe_resource.flags, offset 恒为 0,
+    * 故此 bug 处于潜伏状态（详见 docs/api/07-WINSYS-AUDIT.md）。 */
+   return bo->logical;
 }
 
 static void
diff --git a/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c b/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
index 0b4d3ae..f2c1ad3 100644
--- a/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
+++ b/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
@@ -264,7 +264,17 @@ mwv207_drm_cmdbuf_add_dat(struct mwv207_cmd *cmd, struct cmd_dat *src_dat)
     }
 
     dest_dat->nr_relocs += src_dat->nr_relocs;
-    memcpy(dest_dat->data + dest_dat->size, src_dat->data, src_dat->size);
+    /* FIX(jm9100-oss): O3 —— 每个 0x100 字节槽里只有前 src_dat->size 字节
+     * 是有效数据（sizeof(struct mwv207_texture_config) = 156 = 0x9C），
+     * 而 dest_dat->size 恒按 0x100 步进，于是每槽尾部约 100 字节保持
+     * 未初始化；KMD 会把整个 dat BO 逐字节拷进内核并交给硬件
+     * （mwv207_submit.c 的 copy_from_user 路径），造成 GPU 可见的
+     * 未初始化堆内容。先把整槽清零再写入，尾部即为确定值 0。
+     * 注意：不能改成 "dest_dat->size += src_dat->size" —— 槽步进必须保持
+     * 0x100，否则 cmd_offset 与 reloc 偏移会全部错位（详见
+     * docs/api/07-WINSYS-AUDIT.md）。 */
+    memset(dest_dat->data + dest_dat->size, 0, 0x100);
+    memcpy(dest_dat->data + dest_dat->size, src_dat->data, MIN2(src_dat->size, 0x100u));
     dest_dat->size += 0x100;
 
     return (dest_dat->size - 0x100);
