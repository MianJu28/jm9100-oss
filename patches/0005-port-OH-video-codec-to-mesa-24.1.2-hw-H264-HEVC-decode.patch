+struct mwv207_vp9_slice_header {
+   uint32_t dec_mode;
+
+   uint32_t width; 
+   uint32_t height;
+   uint32_t pic_param_passed_width;
+   uint32_t pic_param_passed_height;
+   uint32_t scaled_width;
+   uint32_t scaled_height;
+   uint32_t prev_width;
+   uint32_t prev_height;
+   uint32_t vp_version;
+   uint32_t vp_profile;
+
+   uint32_t bit_depth;
+   uint32_t key_frame;
+   uint32_t prev_is_key_frame;
+   uint32_t scaling_active;
+   uint32_t resolution_change;
+
+   uint32_t offset_to_dct_parts;
+   enum Vp9ColorSpace color_space;
+   uint32_t clamping;
+   uint32_t error_resilient;
+   uint32_t show_frame;
+   uint32_t prev_show_frame;
+   uint32_t show_existing_frame;
+   uint32_t show_existing_frame_index;
+   uint32_t intra_only;
+   uint32_t subsampling_x;
+   uint32_t subsampling_y;
+
+   uint32_t frame_context_idx;
+   uint32_t active_ref_idx[ALLOWED_REFS_PER_FRAME];
+   uint32_t refresh_frame_flags;
+   uint32_t refresh_entropy_probs;
+   uint32_t frame_parallel_decoding;
+   uint32_t reset_frame_context;
+
+   uint32_t ref_frame_sign_bias[MAX_REF_FRAMES_DEC];
+   int32_t loop_filter_level;
+   uint32_t loop_filter_sharpness;
+
+   int32_t qp_yac, qp_ydc, qp_y2_ac, qp_y2_dc, qp_ch_ac, qp_ch_dc;
+
+   uint32_t lossless;
+   uint32_t transform_mode;
+   uint32_t allow_high_precision_mv;
+   uint32_t allow_comp_inter_inter;
+   uint32_t mcomp_filter_type;
+   uint32_t pred_filter_mode;
+   uint32_t comp_pred_mode;
+   uint32_t comp_fixed_ref;
+   uint32_t comp_var_ref[2];
+   uint32_t log2_tile_columns;
+   uint32_t log2_tile_rows;
+
+   struct mwv207_vp9_entropy_probs entropy;
+   struct mwv207_vp9_entropy_probs entropy_last[NUM_FRAME_CONTEXTS];
+   struct mwv207_vp9_adaptive_entropy_probs prev_ctx;
+   struct mwv207_vp9_entropy_counts ctx_ctr;
+
+   uint32_t segment_enabled;
+   uint32_t segment_map_update;
+   uint32_t segment_map_temporal_update;
+   uint32_t segment_feature_mode;
+   uint32_t segment_feature_enable[MAX_MB_SEGMENTS][SEG_LVL_MAX];
+   int32_t segment_feature_data[MAX_MB_SEGMENTS][SEG_LVL_MAX];
+
+   uint32_t mode_ref_lf_enabled;
+   int32_t mb_ref_lf_delta[MAX_REF_LF_DELTAS];
+   int32_t mb_mode_lf_delta[MAX_MODE_LF_DELTAS];
+   int32_t ref_frame_map[NUM_REF_FRAMES];
+   uint32_t existing_ref_map;
+   uint32_t reset_frame_flags;
+   uint32_t frame_tag_size;
+
+   /* Value to remember last frames prediction for hits into most
+    * probable reference frame */
+   uint32_t refbu_pred_hits;
+   uint32_t probs_decoded;
+};
