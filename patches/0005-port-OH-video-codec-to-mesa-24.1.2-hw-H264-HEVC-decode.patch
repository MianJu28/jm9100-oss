diff --git a/src/gallium/frontends/omx/bellagio/omx_base_audio_port.c b/src/gallium/frontends/omx/bellagio/omx_base_audio_port.c
new file mode 100644
index 0000000..17d8df9
--- /dev/null
+++ b/src/gallium/frontends/omx/bellagio/omx_base_audio_port.c
@@ -0,0 +1,123 @@
+/**
+  src/base/omx_base_audio_port.c
+
+  Base Audio Port class for OpenMAX ports to be used in derived components.
+
+  Copyright (C) 2007-2009 STMicroelectronics
+  Copyright (C) 2007-2009 Nokia Corporation and/or its subsidiary(-ies).
+
