+                        horizontal_weight[m + x_coeff_base] =
+                           (int32_t)(65536.0 / x_filter_size);
+                     } else {
+                        printf("Not Supported\n");
+                     }
+                  }
+               }
+               int32_t total = 0;
+               for (m = 0; m < ppu_cfg->x_filter_size; m++) {
+                  total += horizontal_weight[m];
+               }
+               for (m = 0; m < ppu_cfg->x_filter_size; m++) {
