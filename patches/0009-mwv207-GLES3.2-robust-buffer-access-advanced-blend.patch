       return 14;
    case PIPE_CAP_BLEND_EQUATION_SEPARATE:
       return 1;
+   case PIPE_CAP_BLEND_EQUATION_ADVANCED:
+      /* Backed by a real implementation in mwv207_create_blend_state(): the
+       * hardware extended-blend field encodes 8 of the 15 KHR equations
+       * (MULTIPLY/SCREEN/OVERLAY/DARKEN/LIGHTEN/HARDLIGHT/DIFFERENCE/
+       * EXCLUSION, verified against the spec formulas).  The other 7
+       * (COLORDODGE/COLORBURN/SOFTLIGHT/HSL_*) are a hardware gap and render
+       * without blending, so this is a partial (8/15) guarantee.  Declared to
+       * satisfy the KHR_blend_equation_advanced gate of native GLES 3.2.
+       */
+      return 1;
    case PIPE_CAP_MAX_STREAM_OUTPUT_BUFFERS:
       return 4;
    case PIPE_CAP_STREAM_OUTPUT_INTERLEAVE_BUFFERS:
@@ -261,7 +271,12 @@ mwv207_get_param(struct pipe_screen *pscreen, enum pipe_cap param)
    case PIPE_CAP_FBFETCH:
       return 0;
    case PIPE_CAP_ROBUST_BUFFER_ACCESS_BEHAVIOR:
-      return 0;
+      /* Real guarantee, not a declaration lie: SSBO offsets are clamped by
+       * nir_lower_robust_access() in mwv207_compile_shader().  This unlocks
+       * GL_KHR_robust_buffer_access_behavior + GL_KHR_robustness, and
+       * KHR_robustness is the last gate blocking native GLES 3.2.
+       */
+      return 1;
    case PIPE_CAP_COPY_BETWEEN_COMPRESSED_AND_PLAIN_FORMATS:
       return 1;
 
diff --git a/src/gallium/drivers/mwv207/nir/mwv207_compiler.c b/src/gallium/drivers/mwv207/nir/mwv207_compiler.c
index 50f69f7..f43e02f 100644
--- a/src/gallium/drivers/mwv207/nir/mwv207_compiler.c
+++ b/src/gallium/drivers/mwv207/nir/mwv207_compiler.c
@@ -423,6 +423,24 @@ mwv207_compile_shader(struct mwv207_context *ctx, struct mwv207_shader_state *st
    c->shader = shader;
    c->nir = nir_shader_clone(NULL, shader->info->nir);
 
+   /* PIPE_CAP_ROBUST_BUFFER_ACCESS_BEHAVIOR is advertised (see
+    * mwv207_screen.c), so the guarantee has to actually hold: clamp every
+    * SSBO access offset to an in-bounds value before it reaches the hardware.
+    * Mesa then exposes GL_KHR_robust_buffer_access_behavior / GL_KHR_robustness,
+    * and KHR_robustness is one of the gates for GLES 3.2.
+    *
+    * Only SSBOs are lowered on purpose:
+    *  - the driver implements get_ssbo_size() but NOT get_ubo_size(), so
+    *    .lower_ubo would emit an unimplemented intrinsic;
+    *  - this pass in 24.1.2 only matches non-deref image intrinsics, while the
+    *    driver sees image_deref_*, so .lower_image would be a no-op here;
+    *  - .lower_shared is a Vulkan/debug concern.
+    */
+   const nir_lower_robust_access_options robust_opts = {
+      .lower_ssbo = true,
+   };
+   NIR_PASS_V(c->nir, nir_lower_robust_access, &robust_opts);
+
    mwv207_lower(ctx, c);
 
    mwv207_record_input(c);
