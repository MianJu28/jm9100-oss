 /*
+ * Fast path: copy between two FBOs with GL_EXT_framebuffer_blit.
+ *
+ * glamor's regular GPU->GPU copy paints the source pixmap as a texture through
+ * a fragment shader.  On some drivers a PE ("3D") copy is several times slower
+ * than the blit engine, so use a real blit whenever the copy is simple enough
+ * for the GL semantics to be identical:
+ *
+ *  - a single box, no reverse / upside-down / bitplane handling,
+ *  - GXcopy with a planemask covering the whole depth (or no GC at all),
+ *  - both pixmaps fit in a single FBO and use the same GL texture format,
+ *  - non-overlapping (glamor_copy_needs_temp() already handled the rest).
+ *
+ * Define GLAMOR_NO_BLIT=1 in the environment to disable it (for A/B testing).
+ */
+static Bool
+glamor_copy_fbo_fbo_blit(DrawablePtr src,
+                         DrawablePtr dst,
+                         GCPtr gc,
+                         BoxPtr box,
+                         int nbox,
+                         int dx,
+                         int dy,
+                         Bool reverse,
+                         Bool upsidedown,
+                         Pixel bitplane)
+{
+    ScreenPtr screen = dst->pScreen;
+    glamor_screen_private *glamor_priv = glamor_get_screen_private(screen);
+    PixmapPtr src_pixmap = glamor_get_drawable_pixmap(src);
+    PixmapPtr dst_pixmap = glamor_get_drawable_pixmap(dst);
+    glamor_pixmap_private *src_priv = glamor_get_pixmap_private(src_pixmap);
+    glamor_pixmap_private *dst_priv = glamor_get_pixmap_private(dst_pixmap);
+    const struct glamor_format *src_fmt, *dst_fmt;
+    glamor_pixmap_fbo *src_fbo, *dst_fbo;
+    int src_off_x, src_off_y, dst_off_x, dst_off_y;
+
+    if (!glamor_priv->has_fbo_blit || getenv("GLAMOR_NO_BLIT"))
+        return FALSE;
+
+    if (nbox != 1 || reverse || upsidedown || bitplane != 0)
+        return FALSE;
+
+    if (gc) {
+        if (gc->alu != GXcopy)
+            return FALSE;
+        if (dst->depth < 32) {
+            Pixel bits = ((Pixel) 1 << dst->depth) - 1;
+            if ((gc->planemask & bits) != bits)
+                return FALSE;
+        }
+    }
+
+    if (glamor_pixmap_priv_is_large(src_priv) ||
+        glamor_pixmap_priv_is_large(dst_priv))
+        return FALSE;
+
+    if (src_priv->type == GLAMOR_DRM_ONLY || dst_priv->type == GLAMOR_DRM_ONLY)
+        return FALSE;
+
+    if (!src_priv->fbo || !dst_priv->fbo)
+        return FALSE;
+
+    src_fmt = glamor_format_for_pixmap(src_pixmap);
+    dst_fmt = glamor_format_for_pixmap(dst_pixmap);
+    if (src_fmt->internalformat != dst_fmt->internalformat ||
+        src_fmt->format != dst_fmt->format ||
+        src_fmt->type != dst_fmt->type)
+        return FALSE;
+
+    if (!glamor_pixmap_ensure_fbo(src_pixmap, 0) ||
+        !glamor_pixmap_ensure_fbo(dst_pixmap, 0))
+        return FALSE;
+
+    src_fbo = src_priv->fbo;
+    dst_fbo = dst_priv->fbo;
+
+    glamor_get_drawable_deltas(src, src_pixmap, &src_off_x, &src_off_y);
+    glamor_get_drawable_deltas(dst, dst_pixmap, &dst_off_x, &dst_off_y);
+
+    glamor_make_current(glamor_priv);
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, src_fbo->fb);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dst_fbo->fb);
+    glBlitFramebuffer(box->x1 + src_off_x + dx, box->y1 + src_off_y + dy,
+                      box->x2 + src_off_x + dx, box->y2 + src_off_y + dy,
+                      box->x1 + dst_off_x, box->y1 + dst_off_y,
+                      box->x2 + dst_off_x, box->y2 + dst_off_y,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+
+    /* Leave the destination bound with a full viewport, as glamor's
+     * callers expect. */
+    glBindFramebuffer(GL_FRAMEBUFFER, dst_fbo->fb);
+    glViewport(0, 0, dst_pixmap->drawable.width, dst_pixmap->drawable.height);
+
+    return TRUE;
+}
+
