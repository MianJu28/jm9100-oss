+                                  (void *)(uintptr_t)bo->name);
+   _mesa_hash_table_remove_key(ws->bo_export_table,
+                               (void *)(uintptr_t)bo->handle);
    simple_mtx_unlock(&ws->bo_export_table_lock);
 
    memset(&args, 0, sizeof(args));
@@ -289,17 +295,23 @@ mwv207_drm_bo_map(struct mwv207_winsys *ws, struct mwv207_bo *bo)
    args.in.handle = bo->handle;
 
    err = drmCommandWriteRead(ws->fd, 0x02, &args, sizeof(args));
-   if (err < 0)
-      printf("%s ret : %d\n", __FUNCTION__, err);
+   if (err < 0) {
+      fprintf(stderr, "mwv207: GEM_MMAP ioctl failed for handle %u: %s\n",
+              bo->handle, strerror(errno));
+      return NULL;
+   }
 
    ptr = os_mmap(0, bo->base.size, PROT_READ | PROT_WRITE, MAP_SHARED, ws->fd, args.out.offset);
 
-   if (ptr == MAP_FAILED)
-     return NULL;
+   if (ptr == MAP_FAILED) {
+      fprintf(stderr, "mwv207: mmap failed for handle %u size %u: %s\n",
+              bo->handle, (unsigned)bo->base.size, strerror(errno));
+      return NULL;
+   }
 
    bo->logical = (char *)ptr + bo->offset;
 
-   return ptr;
+   return bo->logical;
 }
 
 static void
@@ -328,8 +340,10 @@ mwv207_drm_bo_get_handle(struct mwv207_winsys *ws,
       args.handle = bo->handle;
 
       ret = drmIoctl(ws->fd, DRM_IOCTL_GEM_FLINK, &args);
-      if (ret)
-         return ret;
+      if (ret) {
+         fprintf(stderr, "mwv207: GEM_FLINK failed: %s\n", strerror(errno));
+         return -EINVAL;
+      }
       whandle->handle = args.name;
       bo->name = args.name;
    }
@@ -361,7 +375,7 @@ mwv207_drm_bo_from_handle(struct mwv207_winsys *ws,
       uint32_t name = whandle->handle;
       struct drm_gem_open args;
 
-      bo = util_hash_table_get(ws->bo_name_table, &name);
+      bo = util_hash_table_get(ws->bo_name_table, (void *)(uintptr_t)name);
       if(bo)
          goto unlock;
 
@@ -381,7 +395,7 @@ mwv207_drm_bo_from_handle(struct mwv207_winsys *ws,
       }
    }
 
-   bo = util_hash_table_get(ws->bo_export_table, &handle);
+   bo = util_hash_table_get(ws->bo_export_table, (void *)(uintptr_t)handle);
    if(bo) {
 
       struct mwv207_bo *ref = NULL;
@@ -389,7 +403,9 @@ mwv207_drm_bo_from_handle(struct mwv207_winsys *ws,
       goto unlock;
    }
 
-   bo = CALLOC_STRUCT(mwv207_bo);   
+   bo = CALLOC_STRUCT(mwv207_bo);
+   if (!bo)
+      goto unlock;
    pb_cache_init_entry(&ws->bo_cache, &bo->u.real.cache_entry, &bo->base, 0);
    bo->base.alignment_log2 = util_logbase2(size);
    bo->base.usage = 0;
@@ -405,13 +421,16 @@ mwv207_drm_bo_from_handle(struct mwv207_winsys *ws,
 
    if (whandle->type == WINSYS_HANDLE_TYPE_SHARED) {
       bo->name = whandle->handle;
-      _mesa_hash_table_insert(ws->bo_name_table, (void*)(uintptr_t)bo->name, bo);
+      _mesa_hash_table_insert(ws->bo_name_table, (void *)(uintptr_t)bo->name, bo);
    }
    _mesa_hash_table_insert(ws->bo_export_table, (void*)(uintptr_t)bo->handle, bo);
 
 unlock:
    simple_mtx_unlock(&ws->bo_export_table_lock);
 
+   if (!bo)
+      return NULL;
+
    if(unlikely(ws->debug & (1<<2)))
       printf("%s bo handle %u type %u result : %u\n", __FUNCTION__, bo->handle, whandle->type, whandle->handle);
 
diff --git a/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c b/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
index 9b38ddf..6aeab83 100644
--- a/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
+++ b/src/gallium/winsys/mwv207/drm/mwv207_drm_cs.c
@@ -28,6 +28,7 @@
 
 
 #include <libsync.h>
+#include <limits.h>
 #include "util/u_memory.h"
 #include "util/u_inlines.h"
 #include "util/u_hash_table.h"
@@ -87,10 +88,21 @@ mwv207_drm_fence_wait(struct mwv207_winsys *ws,
                       struct pipe_fence_handle *fence,
                       uint64_t timeout)
 {
-   if (fence->fd >= 0)
-      return !sync_wait(fence->fd, timeout / 1000000);
-   else
-      return true;
+   if (fence->fd >= 0) {
+      int timeout_ms;
+
+      if (timeout == PIPE_TIMEOUT_INFINITE)
+         timeout_ms = -1; /* sync_wait(): -1 waits forever */
+      else {
+         timeout_ms = (int)(timeout / 1000000);
+         if (timeout_ms < 0)
+            timeout_ms = INT_MAX; /* clamp; avoids int overflow UB */
+      }
+
+      return !sync_wait(fence->fd, timeout_ms);
+   }
+
+   return true;
 }
 
 static int
@@ -114,10 +126,14 @@ mwv207_drm_cmdbuf_create(struct mwv207_winsys *ws)
 {
    struct mwv207_cmd *cmd = CALLOC_STRUCT(mwv207_cmd);
 
+   if (!cmd)
+      return NULL;
+
    cmd->ws = ws;
 
    cmd->buf = (uint8_t *)MALLOC((32<<10));
-   assert(cmd->buf);
+   if (!cmd->buf)
+      goto fail;
 
    cmd->size = (32<<10);
    cmd->offset = 0;
@@ -126,11 +142,15 @@ mwv207_drm_cmdbuf_create(struct mwv207_winsys *ws)
    cmd->nr_relocs = 0;
    cmd->nr_max_relocs = 128;
    cmd->relocs = CALLOC(cmd->nr_max_relocs, sizeof(struct drm_mwv207_submit_reloc));
+   if (!cmd->relocs)
