 static void
@@ -173,22 +205,34 @@ mwv207_drm_cmdbuf_add_bo(struct mwv207_cmd *cmd, struct mwv207_bo *bo, uint32_t
 
    for (i = 0; i < cmd->nr_bos; ++i) {
