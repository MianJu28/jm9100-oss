+inc_gallium_drivers = include_directories('..')
 
 files_libmwv207 = files(
 	'nir/mwv207_disasm.c',
@@ -55,7 +57,7 @@ files_libmwv207 = files(
 libmwv207 = static_library(
   'mwv207',
   files_libmwv207,
-  include_directories : [inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_mwv207_drm, inc_mwv207, inc_mwv207_nir],
+  include_directories : [inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_mwv207_drm, inc_mwv207, inc_mwv207_nir, inc_gallium_drivers],
   gnu_symbol_visibility : 'hidden',
   dependencies: [idep_nir_headers],
 )
diff --git a/src/gallium/drivers/mwv207/mwv207_context.c b/src/gallium/drivers/mwv207/mwv207_context.c
index 050c508..d8a48a4 100644
--- a/src/gallium/drivers/mwv207/mwv207_context.c
+++ b/src/gallium/drivers/mwv207/mwv207_context.c
@@ -89,8 +89,14 @@ mwv207_flush(struct pipe_context *pctx,
          mwv207_merge_128bit(pctx, surface->base.texture);
    }
 
-   if (pfence)
-      *pfence = ctx->ws->fence_create(ctx->ws, out_fence_fd);
+   if (pfence) {
+      struct pipe_fence_handle *f = ctx->ws->fence_create(ctx->ws, out_fence_fd);
+      if (!f && out_fence_fd >= 0) {
+         /* don't leak the sync fd if the fence wrapper alloc failed */
+         close(out_fence_fd);
+      }
+      *pfence = f;
+   }
 }
 
 static void
@@ -214,9 +220,20 @@ mwv207_context_create(struct pipe_screen *pscreen, void *priv, unsigned flags)
    return &ctx->base;
 
 fail:
-
-   if (ctx)
+   /* unwind everything created above before returning NULL */
+   if (ctx) {
+      if (ctx->cmd)
+         ctx->ws->cmdbuf_destory(ctx->ws, ctx->cmd);
+      if (ctx->dma)
+         ctx->ws->cmdbuf_destory(ctx->ws, ctx->dma);
+      if (ctx->blitter)
+         util_blitter_destroy(ctx->blitter);
+      if (ctx->primconvert)
+         util_primconvert_destroy(ctx->primconvert);
+      if (ctx->base.stream_uploader)
+         u_upload_destroy(ctx->base.stream_uploader);
       FREE(ctx);
+   }
 
    return NULL;
 }
diff --git a/src/gallium/drivers/mwv207/mwv207_resource.c b/src/gallium/drivers/mwv207/mwv207_resource.c
index e8ad149..b1f1e6d 100644
--- a/src/gallium/drivers/mwv207/mwv207_resource.c
+++ b/src/gallium/drivers/mwv207/mwv207_resource.c
@@ -231,6 +231,9 @@ resource_create(struct pipe_screen *pscreen,
    enum mwv207_bo_flag flag = MWV207_FLAG_CPU_ACCESS;
    enum mwv207_bo_domain domain = MWV207_DOMAIN_VRAM;
 
+   if (!res)
+      return NULL;
+
    res->base = *templ;
 
    res->base.nr_samples = 1;
@@ -264,6 +267,15 @@ resource_create(struct pipe_screen *pscreen,
    else
       res->bo = screen->ws->bo_create(screen->ws, res->size, domain, flag);
 
+   if (!res->bo) {
+      /* Without a BO the resource is unusable; returning it anyway leads
+       * to a NULL deref on the first draw/flush.  Free and report
+       * failure instead.  (For from_handle callers the imported BO is
+       * owned by the winsys export table; nothing to release here.) */
+      FREE(res);
+      return NULL;
+   }
+
    return &res->base;
 }
 
