       drmUnmap(bo->logical, bo->base.size);
 
    simple_mtx_lock(&ws->bo_export_table_lock);
-   if(bo->name)
-      _mesa_hash_table_remove_key(ws->bo_name_table, &bo->name);
-   _mesa_hash_table_remove_key(ws->bo_export_table, &bo->handle);
+   /* Keys are stored as (void*)(uintptr_t)value (ptr-key table);
+    * passing &bo->name / &bo->handle (address of the struct field)
+    * never matched the inserted key, so entries were never removed
