diff --git a/src/gallium/drivers/mwv207/nir/mwv207_disasm.h b/src/gallium/drivers/mwv207/nir/mwv207_disasm.h
index 60ff222..61bd798 100644
--- a/src/gallium/drivers/mwv207/nir/mwv207_disasm.h
+++ b/src/gallium/drivers/mwv207/nir/mwv207_disasm.h
@@ -27,6 +27,19 @@
 
 #ifndef H_MWV207_ASM
 #define H_MWV207_ASM
+/* The MWV207 ISA encoding (INST_OPCODE_*, INST_TYPE_*, INST_ROUND_MODE_*,
+ * INST_CONDITION_*, INST_EXT_OPCODE_*) is shared with the Vivante-derived
+ * instruction set used by etnaviv; the generated isa.xml.h provides those
+ * definitions.  Upstream jemoic/mesa omitted this include, so the driver
+ * could not build outside the vendor's private tree. */
+#include "etnaviv/hw/isa.xml.h"
+
+/* mwv207 opcode tables spell the default condition "MWV207_TRUE" while
+ * the shared ISA header defines INST_CONDITION_TRUE. */
+#ifndef INST_CONDITION_MWV207_TRUE
+#define INST_CONDITION_MWV207_TRUE INST_CONDITION_TRUE
+#endif
+
 
 #define PACKED __attribute__((__packed__))
 
diff --git a/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c b/src/gallium/winsys/mwv207/drm/mwv207_drm_bo.c
