From b0479baedf015c8ac3440c192b076a55e1477f6d Mon Sep 17 00:00:00 2001
From: jm9100-oss <jm9100-oss@localhost>
Date: Fri, 30 Oct 2026 22:54:34 +0800
Subject: [PATCH] mwv207 KMD (6.6): port our 5.10 fix set onto the community
 port
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

基线 = Icenowy/mwv207-dkms 20260308（开源 mwv207 KMD 的 6.6+ 移植），
对着运行内核 6.6.155-arm64-desktop-hwe 可原样编译。本提交把 5.10 树里
0ec4816 + d94c106 的修复逐条搬过来：

- bo.c     K1  '!jbo->flags & (1<<0)' 恒为 0 → kmap 权限检查从未生效
- ctx.c    K10 scheds[6] 定长栈数组 + BUG_ON → 加界检查 + WARN_ON/-EINVAL
- db.c     K3  copy_to_user 残值当 ioctl 返回值 → -EFAULT；bsearch 前初始化 rec.val
           K4  sort/bsearch 元素尺寸硬编码 8 → sizeof(*db->db)
           K5  fini 后 jdev->db 悬垂 → 置 NULL
- irq.c    K8  irq_create_mapping 返回值未检查 → 干净失败 + 部分映射回收
- submit.c K6  5 处 copy_from_user 残值当 ioctl 返回值 → -EFAULT
           K7  relocs 失败不释放 → kvfree + NULL
               engine_id 是 u32，'>= 0' 恒真 → 删除
- drv.c    patch 0008 的 MODULE_SOFTDEP("pre: governor_performance")

刻意未移植：K2（ttm_bo_init 失败时补 drm_gem_object_release + kfree）。
6.6 的 ttm_bo_init_reserved() 失败路径已走 ttm_bo_put() → bo->destroy
（= mwv207_ttm_bo_destroy，内部本就 release + free），照搬即 double free。
依据：v6.6.155 drivers/gpu/drm/ttm/ttm_bo.c 的 err_put 路径。

构建：make -C /lib/modules/6.6.155-arm64-desktop-hwe/build M=$PWD CONFIG_DRM_MWV207=m
自检：vermagic 与运行内核逐字一致；name=mwv207；softdep=pre: governor_performance；
      alias=pci:v00000731d00009100…；产物 5,857,816 B
---
 mwv207_bo.c     |  5 ++++-
 mwv207_ctx.c    | 12 ++++++++++--
 mwv207_db.c     | 18 +++++++++++++-----
 mwv207_drv.c    |  6 ++++++
 mwv207_irq.c    | 18 ++++++++++++++----
 mwv207_submit.c | 33 +++++++++++++++++++++++++--------
 6 files changed, 72 insertions(+), 20 deletions(-)

diff --git a/mwv207_bo.c b/mwv207_bo.c
index 1c8d157..646f75d 100644
--- a/mwv207_bo.c
+++ b/mwv207_bo.c
@@ -167,7 +167,10 @@ int mwv207_bo_kmap_reserved(struct mwv207_bo *jbo, void **ptr)
 	bool is_iomem;
 	int ret;
 
-	if (!jbo->flags & (1<<0))
+	/* K1: "!flags & bit" parses as (!flags) & bit, which is always 0, so
+	 * this permission check never fired and kmap succeeded on BOs that are
+	 * not CPU-visible. */
+	if (!(jbo->flags & (1<<0)))
 		return -EPERM;
 
 	if (jbo->kptr) {
diff --git a/mwv207_ctx.c b/mwv207_ctx.c
index abb6b41..e04bcbf 100644
--- a/mwv207_ctx.c
+++ b/mwv207_ctx.c
@@ -52,14 +52,21 @@ static void mwv207_ctx_entity_fini(struct mwv207_ctx *ctx)
 	}
 }
 
+#define MWV207_MAX_SCHED_PER_ENGINE 6
+
 static int mwv207_ctx_entity_init_single(struct mwv207_ctx *ctx,
 		struct drm_gpu_scheduler **sched,
 		struct drm_sched_entity **entities, int nr)
 {
-	struct drm_gpu_scheduler *scheds[6];
+	struct drm_gpu_scheduler *scheds[MWV207_MAX_SCHED_PER_ENGINE];
 	struct drm_sched_entity *entity;
 	int i, ret;
 
+	/* K10: scheds[] is a fixed-size stack array; filling more entries than
+	 * it can hold would smash the stack silently. Fail loudly instead. */
+	if (nr > MWV207_MAX_SCHED_PER_ENGINE)
+		return -EINVAL;
+
 	for (i = 0; i < nr; i++) {
 		scheds[i] = sched[i];
 
@@ -103,7 +110,8 @@ static int mwv207_ctx_entity_init(struct drm_device *dev, struct mwv207_ctx *ctx
 	ctx->entity_enc = &ctx->entity_dec[1 + 1];
 	ctx->entity_2d  = &ctx->entity_enc[1 + 1];
 	ctx->entity_dma = &ctx->entity_2d[1 + 1];
-	BUG_ON(ctx->entity_dma[1] != ctx->entities[11 - 1]);
+	if (WARN_ON(ctx->entity_dma[1] != ctx->entities[11 - 1]))
+		return -EINVAL;
 
 	ret = mwv207_ctx_entity_init_single(ctx, jdev->sched_3d, ctx->entity_3d, jdev->nr_3d);
 	if (ret)
diff --git a/mwv207_db.c b/mwv207_db.c
index d7a2e56..61e96a1 100644
--- a/mwv207_db.c
+++ b/mwv207_db.c
@@ -50,6 +50,7 @@ int mwv207_db_init(struct mwv207_device *jdev)
 void mwv207_db_fini(struct mwv207_device *jdev)
 {
 	devm_kfree(jdev->dev, jdev->db);
+	jdev->db = NULL;	/* K5: no dangling pointer for in-flight ioctls */
 }
 
 int mwv207_db_add(struct mwv207_device *jdev, u32 key, u32 val)
@@ -92,7 +93,7 @@ void mwv207_db_sort(struct mwv207_device *jdev)
 	if (db->nr < 2)
 		return;
 
-	sort(db->db, db->nr, 8, cmp_key, NULL);
+	sort(db->db, db->nr, sizeof(*db->db), cmp_key, NULL);	/* K4: was hardcoded 8 */
 
 	for (i = 0; i < db->nr - 1; ++i) {
 		if (db->db[i].key == db->db[i + 1].key) {
@@ -113,7 +114,8 @@ int mwv207_db_ioctl(struct drm_device *dev, void *data,
 	switch (args->op) {
 	case 1:
 		rec.key = args->nr_recs;
-		result = bsearch(&rec, db->db, db->nr, 8, cmp_key);
+		rec.val = 0;	/* K3: keep cmp_key() from reading garbage */
+		result = bsearch(&rec, db->db, db->nr, sizeof(*db->db), cmp_key);	/* K4 */
 		if (!result) {
 			args->recs = 0;
 			return -ENOENT;
@@ -122,9 +124,15 @@ int mwv207_db_ioctl(struct drm_device *dev, void *data,
 
 		break;
 	case 0:
-		if (args->recs)
-			return copy_to_user((void __user *)args->recs, db->db,
-					db->nr * sizeof(struct drm_mwv207_info_rec));
+		if (args->recs) {
+			/* K3: copy_to_user() returns the number of bytes NOT
+			 * copied. Returning that value made a partial/failed
+			 * copy look like a positive ioctl success. */
+			if (copy_to_user((void __user *)args->recs, db->db,
+					db->nr * sizeof(struct drm_mwv207_info_rec)))
+				return -EFAULT;
+			return 0;
+		}
 		args->nr_recs = db->nr;
 
 		break;
diff --git a/mwv207_drv.c b/mwv207_drv.c
index 89fe31d..f0bbb60 100644
--- a/mwv207_drv.c
+++ b/mwv207_drv.c
@@ -535,4 +535,10 @@ module_init(mwv207_init);
 module_exit(mwv207_exit);
 MODULE_DESCRIPTION("MWV207 Graphics Driver");
 MODULE_AUTHOR("shanjinkui");
+/*
+ * devfreq 在注册设备时会请求 performance governor；若 governor_performance.ko
+ * 尚未加载，注册退回 simple_ondemand 并导致开机低频（见 PERFORMANCE-REPORT）。
+ * 声明 softdep 让 modprobe 在加载本驱动前先拉起该模块。
+ */
+MODULE_SOFTDEP("pre: governor_performance");
 MODULE_LICENSE("GPL");
diff --git a/mwv207_irq.c b/mwv207_irq.c
index 977200c..e428a48 100644
--- a/mwv207_irq.c
+++ b/mwv207_irq.c
@@ -144,8 +144,15 @@ int mwv207_irq_init(struct mwv207_device *jdev)
 	if (!jdev->irq_domain)
 		return -ENODEV;
 
-	for (i = 0; i < 64; ++i)
-		irq_create_mapping(jdev->irq_domain, i);
+	for (i = 0; i < 64; ++i) {
+		/* K8: the return value used to be ignored; a failed mapping
+		 * surfaced later as BUG_ON(va_irq == 0) in the KMS init path or
+		 * as request_irq(0) failing with -ENOMEM. */
+		if (!irq_create_mapping(jdev->irq_domain, i)) {
+			ret = -ENOMEM;
+			goto free_mapping_partial;
+		}
+	}
 
 	ret = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_MSI | PCI_IRQ_INTX);
 	if (ret < 1) {
@@ -162,10 +169,13 @@ int mwv207_irq_init(struct mwv207_device *jdev)
 free_vec:
 	pci_free_irq_vectors(pdev);
 free_mapping:
-	for (i = 0; i < 64; ++i) {
+	i = 64;
+free_mapping_partial:
+	for (; i-- > 0;) {
 		int irq = irq_find_mapping(jdev->irq_domain, i);
 
-		irq_dispose_mapping(irq);
+		if (irq)
+			irq_dispose_mapping(irq);
 	}
 
 	irq_domain_remove(jdev->irq_domain);
diff --git a/mwv207_submit.c b/mwv207_submit.c
index ae5cc40..f0d0ff5 100644
--- a/mwv207_submit.c
+++ b/mwv207_submit.c
@@ -61,7 +61,7 @@ static inline int mwv207_submit_select_engine(struct drm_device *dev, struct mwv
 
 	if (args->engine_id == 0xffffffff)
 		id = id_max;
-	else if (args->engine_id >= 0 && args->engine_id < id_max)
+	else if (args->engine_id < id_max)	/* u32: '>= 0' is always true */
 		id = args->engine_id;
 	else
 		return -ENODEV;
@@ -94,8 +94,15 @@ static int mwv207_submit_init_job_reloc(struct mwv207_job *mjob, struct drm_mwv2
 	mjob->relocs = kvmalloc_array(mjob->nr_relocs,
 			sizeof(struct drm_mwv207_submit_reloc), GFP_KERNEL);
 
-	return copy_from_user(mjob->relocs, (void __user *)args->relocs,
-			sizeof(struct drm_mwv207_submit_reloc) * mjob->nr_relocs);
+	/* K6: copy_from_user() returns the residue, which used to be echoed
+	 * back as a positive ioctl result. Free the array on failure (K7). */
+	if (copy_from_user(mjob->relocs, (void __user *)args->relocs,
+			sizeof(struct drm_mwv207_submit_reloc) * mjob->nr_relocs)) {
+		kvfree(mjob->relocs);
+		mjob->relocs = NULL;
+		return -EFAULT;
+	}
+	return 0;
 }
 
 static int mwv207_submit_init_job_bo(struct mwv207_job *mjob,
@@ -127,8 +134,10 @@ static int mwv207_submit_init_job_bo(struct mwv207_job *mjob,
 
 	ret = copy_from_user(ubos, (void __user *)args->bos,
 			mjob->nr_bos * sizeof(*ubos));
-	if (ret)
+	if (ret) {
+		ret = -EFAULT;
 		goto out;
+	}
 setup_mtvb:
 	mjob->mtvb = kvcalloc(mjob->nr_bos + mjob->nr_cmd_dat,
 			sizeof(struct mwv207_tvb), GFP_KERNEL);
@@ -182,7 +191,9 @@ static int mwv207_submit_init_job_cmd(struct mwv207_job *mjob, struct drm_mwv207
 	if (!mjob->cmds)
 		return -ENOMEM;
 
-	return copy_from_user(mjob->cmds, (void __user *)args->cmds, mjob->cmd_size);
+	if (copy_from_user(mjob->cmds, (void __user *)args->cmds, mjob->cmd_size))
+		return -EFAULT;	/* K6: residue must not leak out as success */
+	return 0;
 }
 
 static int mwv207_submit_init_job_cmd_dat(struct drm_device *dev,
@@ -217,8 +228,10 @@ static int mwv207_submit_init_job_cmd_dat(struct drm_device *dev,
 
 	ret = copy_from_user(udats, (void __user *)args->cmd_dats,
 			mjob->nr_cmd_dat * sizeof(struct drm_mwv207_submit_cmd_dat));
-	if (ret)
+	if (ret) {
+		ret = -EFAULT;
 		goto out;
+	}
 
 	for (i = 0; i < mjob->nr_cmd_dat; ++i) {
 		if ((int)udats[i].nr_relocs < 0) {
@@ -248,8 +261,10 @@ static int mwv207_submit_init_job_cmd_dat(struct drm_device *dev,
 			}
 			ret = copy_from_user(mdat->relocs, (void __user *)udats[i].relocs,
 					mdat->nr_relocs * sizeof(struct drm_mwv207_submit_reloc));
-			if (ret)
+			if (ret) {
+				ret = -EFAULT;
 				goto out;
+			}
 		}
 		mdat->dat_size = udats[i].dat_size;
 		mdat->dat = kvmalloc(mdat->dat_size, GFP_KERNEL);
@@ -258,8 +273,10 @@ static int mwv207_submit_init_job_cmd_dat(struct drm_device *dev,
 			goto out;
 		}
 		ret = copy_from_user(mdat->dat, (void __user *)udats[i].dat, mdat->dat_size);
-		if (ret)
+		if (ret) {
+			ret = -EFAULT;
 			goto out;
+		}
 		ret = mwv207_bo_create(jdev, mdat->dat_size, 0x1000, ttm_bo_type_device,
 				0x2, (1<<0),
 				&mdat->jbo);
-- 
