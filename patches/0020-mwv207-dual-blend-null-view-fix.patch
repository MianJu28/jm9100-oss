diff --git a/src/gallium/drivers/mwv207/mwv207_draw.c b/src/gallium/drivers/mwv207/mwv207_draw.c
index 069055a..485ce71 100644
--- a/src/gallium/drivers/mwv207/mwv207_draw.c
+++ b/src/gallium/drivers/mwv207/mwv207_draw.c
@@ -1178,6 +1178,16 @@ mwv207_config_dual_blend(struct pipe_context *pctx,
       struct pipe_resource *texture_res;
       struct pipe_blit_info blt_info = {};
 
+      /* FIX(jm9100-oss): Firefox/GitHub 崩溃 (SIGSEGV 0x48)。原代码无条件解引用
+       * cbufs[0]；没有颜色附件（GitHub 站点导航条会短暂切到无 cbuf 的 FBO）时
+       * dual-source blend 无从谈起：关掉 is_dual 跳过绑定，让编译器不走
+       * lower_dual（那里解引用 sampler_views[4][sampler_index]，槽上没视图
+       * 就是空指针）。 */
+      if (!src_surface) {
+         ctx->info.dsbi.is_dual = false;
+         return;
+      }
+
       memset(&res_templ, 0, sizeof(struct pipe_resource));
       res_templ.target = PIPE_TEXTURE_2D;
       res_templ.width0 = src_surface->width;
@@ -1211,15 +1221,24 @@ mwv207_config_dual_blend(struct pipe_context *pctx,
       sampler_view.format = src_surface->format;
 
       ctx->info.dsbi.y_invert = 0;
-      ctx->info.dsbi.sampler_index = ctx->num_samplers[PIPE_SHADER_FRAGMENT];
+      /* FIX(jm9100-oss): 视图与采样器状态必须绑在同一个槽上。原来视图绑在
+       * num_sampler_views[FS]（尾部 NULL 会回缩），而 sampler_index 记的是
+       * num_samplers[FS]（不回缩），两者经常不等 —— lower_dual 按
+       * sampler_index 取视图时拿到 NULL 或错位视图 → 编译期解引用 ->texture
+       * 崩溃 (crash_address 0x48)。统一用视图计数。 */
+      ctx->info.dsbi.sampler_index = ctx->num_sampler_views[PIPE_SHADER_FRAGMENT];
       struct pipe_sampler_view *src_view;
       src_view = pctx->create_sampler_view(pctx, texture_res, &sampler_view);
+      if (!src_view) {
+         ctx->info.dsbi.is_dual = false;
+         return;
+      }
       pctx->set_sampler_views(pctx, PIPE_SHADER_FRAGMENT,
                               ctx->num_sampler_views[PIPE_SHADER_FRAGMENT], 1,
                               0, true, &src_view);
       void *sampler_state = mwv207_get_sampler_state(ctx);
       pctx->bind_sampler_states(pctx, PIPE_SHADER_FRAGMENT,
-                                ctx->num_samplers[PIPE_SHADER_FRAGMENT],
+                                ctx->num_sampler_views[PIPE_SHADER_FRAGMENT],
                                 1, &sampler_state);
       pipe_resource_reference(&texture_res, NULL);
    }
diff --git a/src/gallium/drivers/mwv207/nir/mwv207_lower_dual.c b/src/gallium/drivers/mwv207/nir/mwv207_lower_dual.c
index 5742e9d..6bf4bc0 100644
--- a/src/gallium/drivers/mwv207/nir/mwv207_lower_dual.c
+++ b/src/gallium/drivers/mwv207/nir/mwv207_lower_dual.c
@@ -109,11 +109,30 @@ get_factor_def(struct mwv207_context *ctx, nir_builder *b, unsigned int factor,
 static nir_def *
 get_rt_texture_coord(struct mwv207_context *ctx, nir_builder *b)
 {
+   /* FIX(jm9100-oss): Firefox/GitHub 崩溃 (SIGSEGV / SEGV_MAPERR 0x48)。
+    * 这里原来无条件解引用 sampler_views[4][dsbi.sampler_index]->texture；
+    * 0x48 正是 pipe_sampler_view::texture 的偏移，即槽上视图为 NULL。
+    * 视图槽在 set_sampler_views 里随时可能被解绑/回缩，编译期必须判空：
+    * 没有视图就退回帧缓冲尺寸（lower_dual 只需要把 fragcoord 归一化到
+    * [0,1]，用渲染目标尺寸与 RT blit 拷贝视图等价）。 */
+   struct pipe_sampler_view *rt_view =
+      ctx->sampler_views[4][ctx->info.dsbi.sampler_index];
+   unsigned rt_width, rt_height;
+   if (rt_view && rt_view->texture) {
+      rt_width = rt_view->texture->width0;
+      rt_height = rt_view->texture->height0;
+   } else if (ctx->fb_state.cbufs[0]) {
+      rt_width = ctx->fb_state.cbufs[0]->width;
+      rt_height = ctx->fb_state.cbufs[0]->height;
+   } else {
+      rt_width = ctx->fb_state.width;
+      rt_height = ctx->fb_state.height;
+   }
    nir_def *coord = nir_load_frag_coord(b);
    nir_def *fragcoord_x = nir_channel(b, coord, 0);
    nir_def *fragcoord_y = nir_channel(b, coord, 1);
-   nir_def *width = nir_imm_float(b, ctx->sampler_views[4][ctx->info.dsbi.sampler_index]->texture->width0);
-   nir_def *height = nir_imm_float(b, ctx->sampler_views[4][ctx->info.dsbi.sampler_index]->texture->height0);
+   nir_def *width = nir_imm_float(b, rt_width);
+   nir_def *height = nir_imm_float(b, rt_height);
    nir_def *y_invert = nir_imm_float(b, ctx->info.dsbi.y_invert);
    nir_def *const_one = nir_imm_float(b, 1);
    nir_def *const_two = nir_imm_float(b, 2);
