diff --git a/src/gallium/drivers/mwv207/mwv207_screen.c b/src/gallium/drivers/mwv207/mwv207_screen.c
index 234413a..40baa71 100644
--- a/src/gallium/drivers/mwv207/mwv207_screen.c
+++ b/src/gallium/drivers/mwv207/mwv207_screen.c
@@ -342,6 +342,18 @@ mwv207_get_param(struct pipe_screen *pscreen, enum pipe_cap param)
       /* FIX(jm9100-oss): 反相谓词由 mwv207_check_render_cond() 的
        * render_cond_cond 分支直接支持，声明即可。 */
       return 1;
+   case PIPE_CAP_BUFFER_MAP_PERSISTENT_COHERENT:
+      /* FIX(jm9100-oss): 这里原本靠 gallium 默认值返回 1（见
+       * src/gallium/auxiliary/util/u_screen.c:213-214），于是 st 会让
+       * GL_ARB_buffer_storage 出现在扩展串里（st_extensions.c:761
+       * { o(ARB_buffer_storage), PIPE_CAP_BUFFER_MAP_PERSISTENT_COHERENT }）。
+       * 但驱动既没实现 pipe_context::buffer_storage，也没处理
+       * PIPE_MAP_PERSISTENT / COHERENT 的 transfer 语义；实测 Firefox 的
+       * WebRender 一看到该扩展就走"持久映射"的缓冲上传路径，对没有 data store
+       * 的 buffer 发 glMapBufferRange(WRITE|PERSISTENT|FLUSH_EXPLICIT)，Mesa 每次
+       * 都以 GL_INVALID_OPERATION 拒绝 → 顶点/实例数据传不上去，页面只剩底色、
+       * 图元全丢。真正支持持久映射之前，明确返回 0。 */
+      return 0;
    default:
       return u_pipe_screen_get_param_defaults(pscreen, param);
    }
diff --git a/src/gallium/drivers/mwv207/nir/mwv207_lower.c b/src/gallium/drivers/mwv207/nir/mwv207_lower.c
index 9c8782f..3a800f3 100644
--- a/src/gallium/drivers/mwv207/nir/mwv207_lower.c
+++ b/src/gallium/drivers/mwv207/nir/mwv207_lower.c
@@ -464,8 +464,16 @@ mwv207_lower_io(nir_shader *nir, struct mwv207_shader *shader)
 
                nir_builder_instr_insert(&b, &load->instr);
 
-               nir_def *new_coord = nir_fmul(&b, coord->ssa, &load->def);
-               nir_src_rewrite(coord, new_coord);
+               /* FIX(jm9100-oss): 矩形纹理（GL_TEXTURE_RECTANGLE）的坐标**不做缩放**。
+                * 硬件在采样器状态里已被 st 告知该视图的坐标是"未归一化"的
+                * （st_atom_sampler.c:80 对 GL_TEXTURE_RECTANGLE 置 unnormalized_coords=1，
+                * 驱动把它编到 sampler ctrl0 的 bit15：ALIGN_BIT(!unnormalized_coords,0xF)），
+                * 所以 text() 的像素坐标与 texelFetch() 的纹素索引都应当原样透传。
+                * 原来这里乘 1/size 会让坐标变成归一化值而硬件仍按未归一化解释：
+                * floor(0.875)=0 → 任何坐标都采到纹素 (0,0)（实测 sampler2DRect + texelFetch
+                * 四个不同坐标全返回 (0,0) 纹素，llvmpipe 正常）。这正是火狐 WebRender
+                * 矩形裁剪掩码恒取 0、图元全部不可见（"一半黑一半白"）的根因。 */
+               (void)coord;
             }
          }
       }
