+    * not re-entering an in-progress command stream build. */
+   if (getenv("MWV207_POSTGPU")) {
+      static int npg = 0;
+      struct pipe_framebuffer_state *gfb = &ctx->fb_state;
+      struct pipe_surface *gs = gfb->cbufs[0];
+      if (gs && gs->texture && gs->texture->width0 == 1024 && gs->texture->height0 == 512) {
+         struct pipe_box gbox = {0, 0, 0, 1024, 512, 1};
+         struct pipe_transfer *gtr = NULL;
+         uint8_t *gmap = pctx->texture_map(pctx, gs->texture, 0,
+                                            PIPE_MAP_READ, &gbox, &gtr);
+         if (gmap && gtr) {
+            char gpn[64];
+            snprintf(gpn, sizeof gpn, "/tmp/ffx/pgt_%03d.raw", npg);
+            FILE *gf = fopen(gpn, "wb");
+            if (gf) {
+               for (uint32_t gy = 0; gy < 512; gy++)
+                  fwrite(gmap + (size_t)gy * gtr->stride, 1, 1024 * 4, gf);
+               fclose(gf);
+            }
+            fprintf(stderr, "[POSTGPU] #%d stride=%u\n", npg, gtr->stride);
+            pctx->texture_unmap(pctx, gtr);
+         }
+         npg++;
+      }
+   }
+
    if (unlikely(ctx->ws->debug & 0x40))
