+                  rs->level_infos[0].stride,
+                  sv->u.tex.first_layer, sv->u.tex.last_layer,
+                  sv->u.tex.first_level, sv->u.tex.last_level, sv->u.tex.first_layer);
+            }
+            if (bb) ctx->ws->bo_unmap(ctx->ws, rs->bo);
+         }
+         nd++;
+         }
+      }
+   }
+
+   {
+      const char *da = getenv("MWV207_DIFFAT");
+      static int ndiff2 = 0;
+      if (da && getenv("MWV207_DIFFPOST")) {
+         struct pipe_framebuffer_state *fb = &ctx->fb_state;
+         struct mwv207_surface *s = fb->cbufs[0] ? mwv207_surface(fb->cbufs[0]) : NULL;
+         if (s && fb->width == 1280 && fb->height == 929 &&
+             (atoi(da) < 0 || ndiff2 == atoi(da))) {
+            struct mwv207_resource *r = mwv207_resource(s->base.texture);
+            ctx->ws->bo_wait(ctx->ws, r->bo, 0x7fffffffffffffffULL);
+            uint8_t *b = ctx->ws->bo_map(ctx->ws, r->bo);
+            if (b && ndiff2 >= 20 && ndiff2 <= 30) {
+               uint32_t st = r->level_infos[0].stride;
+               char pn[64]; snprintf(pn,sizeof pn,"/tmp/ffx/post_%02d.raw", ndiff2);
+               FILE *f = fopen(pn, "wb");
+               if (f) { fwrite(b + (uint64_t)r->offset, 1, (size_t)st * 929, f); fclose(f); }
+               fprintf(stderr, "[DIFF] draw=%d POST_DONE bo=%p\n", ndiff2, (void*)r);
+               ctx->ws->bo_unmap(ctx->ws, r->bo);
+            }
+            ndiff2++;
+         }
+      }
+   }
+
+   if (getenv("MWV207_EACHDRAWFLUSH"))
